{
  "name": "chalkmath",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/protocol && npm run build -ws --if-present",
    "test": "npm test -ws --if-present",
    "typecheck": "tsc -p apps/notebook",
    "bundle": "node scripts/bundle.mjs",
    "wasm": "scripts/build-wasm.sh",
    "lean-wasm": "scripts/build-lean-wasm-compiler.sh",
    "smoke:lean": "node scripts/smoke-lean-server.mjs && node scripts/smoke-lean-cells.mjs",
    "test:proofs": "cd proofs && lake build",
    "check:engine": "scripts/check-engine-deps.sh",
    "smoke:ask": "node scripts/smoke-ask.mjs",
    "e2e": "node scripts/e2e-math.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.20.2",
    "esbuild": "^0.24.0",
    "esbuild-plugins-node-modules-polyfill": "^1.8.3",
    "katex": "^0.16.47",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.0"
  }
}
